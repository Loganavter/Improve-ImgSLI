[Desktop Entry]
Name=BlinkTable
Comment=Compare, measure and prove image quality
Exec=blinktable %F
Icon=blinktable
Terminal=false
Type=Application
# Categories must match improve-imgsli.desktop.in (the launcher entry): the same
# app under two different menu sections depending on how it was installed was the
# one real inconsistency between the two desktop files (owner decision 2026-10-28).
Categories=Graphics;Photography;
MimeType=application/vnd.blinktable.project+zip;application/x-improve-imgsli;
# StartupWMClass must equal the app's real WM_CLASS: src/__main__.py sets
# RESOURCE_NAME=blinktable and setDesktopFileName("blinktable") since 2026-10-28
# (before that the pair was the pre-rename `improve-imgsli` on both sides —
# renaming one side alone breaks taskbar grouping).
StartupWMClass=blinktable
StartupNotify=true
