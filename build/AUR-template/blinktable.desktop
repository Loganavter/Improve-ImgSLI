[Desktop Entry]
Name=BlinkTable
Comment=Compare, measure and prove image quality
Exec=blinktable %F
Icon=blinktable
Terminal=false
Type=Application
Categories=Graphics;2DGraphics;
MimeType=application/vnd.blinktable.project+zip;application/x-improve-imgsli;
# StartupWMClass stays on the pre-rename value on purpose: the app sets
# RESOURCE_NAME=improve-imgsli (src/__main__.py:116), so this is its real
# WM_CLASS regardless of how the package/executable is named.
StartupWMClass=improve-imgsli
StartupNotify=true
