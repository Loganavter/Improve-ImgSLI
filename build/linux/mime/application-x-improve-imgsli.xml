<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <!-- LEGACY: pre-rename Improve-ImgSLI project packages (*.imgsli).

       The container format did not change — only its name. The current type
       application/vnd.blinktable.project+zip owns the content magic, but a
       *.imgsli path matches this glob first and keeps resolving to the legacy
       type (measured with shared-mime-info + `xdg-mime query filetype`). This
       entry exists so those paths still resolve to a project type and so old
       per-user "open with" choices keep working — the desktop entry lists both
       types, so opening is unaffected. Never remove without a deprecation
       release that stops opening *.imgsli.
  -->
  <mime-type type="application/x-improve-imgsli">
    <comment>BlinkTable project (legacy .imgsli)</comment>
    <comment xml:lang="ru">Проект BlinkTable (устаревший .imgsli)</comment>
    <comment xml:lang="pt_BR">Projeto BlinkTable (.imgsli legado)</comment>
    <comment xml:lang="zh">BlinkTable 项目（旧版 .imgsli）</comment>
    <acronym>ImgSLI</acronym>
    <icon name="application-vnd.blinktable.project+zip"/>
    <generic-icon name="x-office-document"/>
    <glob weight="60" pattern="*.imgsli"/>
    <glob weight="60" pattern="*.IMGSLI"/>
  </mime-type>
</mime-info>
