/* --- Application-specific styles (main window / app shell) --- */

/* RatingListItem / ZoomIndicator / title text: color+font via palette + UiFont.
   Do not put color/font rules on QLabel — any QSS on a QLabel makes Qt ignore
   setFont() when painting (system face fallback). */

/* --- Workspace tabs bar (top of main window) --- */
QWidget#WorkspaceTabsBar {
    background: @button.toggle.background.normal;
}
