/* --- Общие стили для всего приложения --- */

/* Never put color/font on QLabel here — stylesheet text rules make Qt
   ignore setFont()/UiFont when painting (title bar, lists, toolkit Label). */

/* Toolkit CustomLineEdit / SpinBox paint their own chrome. */
QDialog QLineEdit[custom-line-edit="true"],
QDialog QSpinBox[custom-line-edit="true"] {
    background: transparent;
    border: none;
    padding: 0;
}

/* --- Стили для кастомных виджетов --- */

/* --- Стили для flyout виджетов --- */
QWidget#FlyoutWidget {
    background-color: @flyout.background;
    border: 1px solid @flyout.border;
    border-radius: 8px;
}
QWidget#FlyoutWidget QScrollArea, QWidget#FlyoutWidget QScrollArea > QWidget > QWidget {
    background-color: transparent; border: none;
}
/* RatingListItem text: palette + UiFont in Python (no QLabel color/font QSS). */

/* Toast message color/font: apply_text_color + UiFont in toast.py */
/* ToastProgressBar is painter-owned — do not style via QSS. */
/* PathTooltip chrome/text: painted + palette in tooltips.py (no QLabel QSS). */

/* --- Flyouts (Magnifier, Menu, etc) --- */
/* Value popup chrome lives on #ValuePopupContainer; label uses UiFont + palette. */
#ValuePopupContainer {
    background-color: @flyout.background;
    border: 1px solid @flyout.border;
    border-radius: 6px;
}
