/* --- Стили для кастомных виджетов toolkit --- */

/* --- Стили для flyout виджетов --- */
QWidget#FlyoutWidget, QWidget#FontSettingsContainer {
    background-color: @flyout.background;
    border: 1px solid @flyout.border;
    border-radius: 8px;
}
QWidget#FlyoutWidget[surfaceRole="transparent"] {
    background: transparent;
    border: none;
}
/* NOTE: no QWidget#FlyoutContainer rule on purpose. BaseFlyout paints its
   own background/border (paintEvent) and clips content with RoundedClipEffect
   at the raw CONTENT_RADIUS; a QSS rule here double-painted a border AND got
   its border-radius scaled by the QSS px-scaling pass (8px -> 16px at UI
   scale 2.0) while the clip stayed at 8px — the outline and the content
   clip visibly diverged at scale > 100%. The container is drawn entirely by
   BaseFlyout. */
QWidget#FlyoutWidget QScrollArea, QWidget#FlyoutWidget QScrollArea > QWidget > QWidget {
    background-color: transparent; border: none;
}
#UnifiedFlyoutPanel OverlayScrollArea,
#UnifiedFlyoutPanel OverlayScrollArea > QWidget > QWidget {
    background-color: transparent;
    border: none;
}
#UnifiedFlyoutPanel[surfaceRole="panel"] {
    background-color: @flyout.background;
    border: 1px solid @flyout.border;
    border-radius: 8px;
}
#UnifiedFlyoutPanel[surfaceRole="transparent"] {
    background: transparent;
    border: none;
}

/* --- Toast --- */
QWidget#ToastNotification {
    background: transparent;
    border: none;
}
QWidget#ToastContentWidget {
    background-color: @toast.background;
    border: 1px solid @toast.border;
    border-radius: 8px;
}
QWidget#ToastContentWidget[hasProgress="true"] {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: none;
}
QWidget#ToastProgressContainer[hasProgress="true"] {
    background-color: @toast.background;
    border: 1px solid @toast.border;
    border-top: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}
/* Toast message color/font: apply_text_color + UiFont in toast.py */
QWidget#ToastNotification QPushButton {
    background-color: transparent;
    color: @toast.text;
    border: 1px solid @toast.border;
    border-radius: 6px;
    padding: 4px 10px;
}
/* ToastProgressBar is painter-owned — do not style via QSS. */

/* CustomLineEdit paints its own chrome — do not add QSS padding/bg here;
   that stacks on setTextMargins and clips descenders / inflates left inset. */
QLineEdit[custom-line-edit="true"] {
    background: transparent;
    border: none !important;
    padding: 0;
    margin: 0;
    outline: none;
}
QLineEdit[custom-line-edit="true"]:focus {
    border: none !important;
    outline: none;
}
/* PathTooltip chrome/text: painted + palette in tooltips.py (no QLabel QSS). */

ScrollableComboBox {
    background: transparent;
    border: none;
}

/* --- SpinBox --- */
SpinBox {
    background-color: @dialog.input.background;
    border: 1px solid @input.border.thin;
    border-radius: 2px;
}

SpinBox:focus {
    border: 1px solid @accent;
}

/* Стили для line edit внутри SpinBox */
SpinBox QLineEdit {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
}

