/* --- Стили для VideoEditorDialog --- */

#VideoEditorSettingsPanel {
    background-color: transparent;
    border: none;
}

/* TopTabHost paints tab chrome + pane; keep the host transparent for QSS. */
#VideoEditorTabs {
    background-color: transparent;
    border: none;
}

#VideoEditorTabs #TopTabBar,
#VideoEditorTabs #TopTabPane,
#VideoEditorTabs #TopTabStack {
    background: transparent;
    border: none;
}

/* Внутренний контент вкладок (прозрачный, чтобы видеть фон pane) */
#VideoEditorTabContent {
    background-color: transparent;
}

/* Инпуты — CustomLineEdit paints itself; only reset conflicting QSS chrome. */
#VideoEditorSettingsPanel CustomLineEdit {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#VideoEditorSettingsPanel CustomLineEdit:focus {
    border: none;
}


/* Превью-панель */
#VideoEditorPreviewLabel {
    background-color: #0a0a0a;
    border: 1px solid @separator.color;
    border-radius: 8px;
}

/* FIX: Убираем серый фон у области таймлайна */
#VideoEditorTimelineScrollArea,
#VideoEditorTimelineScrollArea QWidget {
    background-color: transparent;
    border: none;
    background: none;
}

/* Панель инструментов */
#VideoEditorToolbar {
    background: transparent;
    border: none;
    border-top: 1px solid rgba(128, 128, 128, 0.2);
}

#VideoEditorExportProgress {
    border: none;
    background-color: @dialog.input.background;
    border-radius: 2px;
}

#VideoEditorExportProgress::chunk {
    background-color: @accent;
    border-radius: 2px;
}

#VideoEditorExportProgress[state="success"]::chunk {
    background-color: #28a745;
}
