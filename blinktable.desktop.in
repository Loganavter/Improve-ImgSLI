[Desktop Entry]
Type=Application
Name=BlinkTable
Comment=Compare images and video frames
Exec=@LAUNCHER_PATH@ run %F
Icon=@ICON_PATH@
Terminal=false
Categories=Graphics;Photography;
MimeType=application/vnd.blinktable.project+zip;application/x-improve-imgsli;
StartupWMClass=improve-imgsli
StartupNotify=true